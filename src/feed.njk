---
permalink: /blog/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>VNG Blog, Commercial Renovation Insights</title>
    <link>https://www.vullnetnuragroup.com/blog/</link>
    <description>Practical guides for project managers and building owners navigating commercial renovations across Ontario.</description>
    <language>en-ca</language>
    <atom:link href="https://www.vullnetnuragroup.com/blog/feed.xml" rel="self" type="application/rss+xml"/>
    {% for post in collections.blog | limit(20) %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>https://www.vullnetnuragroup.com{{ post.url }}</link>
      <guid isPermaLink="true">https://www.vullnetnuragroup.com{{ post.url }}</guid>
      <description>{{ post.data.description }}</description>
      <pubDate>{{ post.date | isoDate }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>
