      <!-- STEP 3: Scope Level -->
      <div id="est-step-3" class="est-step" style="display:none">
        <div style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--red);margin-bottom:8px">Step 3 of 3</div>
        <h2 style="font-size:clamp(1.4rem,3vw,2rem);color:var(--pure);margin-bottom:8px">What level of finish?</h2>
        <p style="font-size:.9rem;color:var(--gray2);margin-bottom:32px">Be honest, scope level is the biggest driver of cost.</p>
        <div class="est-grid est-grid-3">
          <button class="est-option" data-value="basic" data-label="Basic">
