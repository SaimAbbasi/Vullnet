<style>
.est-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin-bottom:32px}
.est-grid-2{grid-template-columns:repeat(3,1fr)}
.est-grid-3{grid-template-columns:repeat(3,1fr)}
.est-option{background:#1a1a1a;border:2px solid transparent;padding:24px 20px;cursor:pointer;text-align:left;transition:border-color .2s,background .2s;display:flex;flex-direction:column;gap:12px}
.est-option:hover{background:#222;border-color:rgba(216,48,48,.4)}
.est-option.selected{background:#1e1a1a;border-color:var(--red)}
.est-option-icon{color:var(--gray2);transition:color .2s}
.est-option.selected .est-option-icon{color:var(--red)}
.est-option-label{font-size:.88rem;font-weight:700;letter-spacing:.04em;color:var(--pure);text-transform:uppercase;font-family:'Oswald',sans-serif}
.est-option-note{font-size:.78rem;line-height:1.5;color:var(--gray2)}
.est-back-btn{background:none;border:1px solid rgba(255,255,255,.15);color:var(--gray2);padding:10px 20px;font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;font-family:inherit;transition:border-color .2s,color .2s}
.est-back-btn:hover{border-color:rgba(255,255,255,.4);color:var(--pure)}
@media(max-width:640px){.est-grid,.est-grid-2,.est-grid-3{grid-template-columns:1fr 1fr}}
@media(max-width:420px){.est-grid,.est-grid-2,.est-grid-3{grid-template-columns:1fr}}
</style>

<script>
(function(){
  // Cost data: [low, high] per sq ft by [type][scope]
  const rates = {
    office:     { basic:[75,95],    mid:[95,130],   high:[130,185] },
    medical:    { basic:[110,140],  mid:[140,185],  high:[185,260] },
    restaurant: { basic:[100,140],  mid:[140,190],  high:[190,270] },
    retail:     { basic:[65,90],    mid:[90,120],   high:[120,170] },
    industrial: { basic:[55,75],    mid:[75,105],   high:[105,150] },
    pharmacy:   { basic:[100,135],  mid:[135,175],  high:[175,240] }
  };

  const notes = {
    office:     'Office tenant improvements. Includes framing, drywall, ceilings, flooring, painting, and electrical. Excludes furniture.',
    medical:    'Medical and dental clinic fit-outs. Includes specialized mechanical, plumbing provisions, ICRA controls, and healthcare-grade finishes.',
    restaurant: 'Restaurant fit-outs. Includes FOH finishes, BOH rough-in coordination, exhaust hood provisions, and millwork. Kitchen equipment excluded.',
    retail:     'Retail buildouts and showrooms. Includes storefront framing, lighting, flooring, and basic millwork. Fixtures and signage excluded.',
    industrial: 'Industrial office build-outs inside existing warehouse or industrial buildings. Includes framing, drywall, ceilings, and basic finishes.',
    pharmacy:   'Pharmacy fit-outs including dispensary, consultation room(s), accessible service counters, and retail floor. Narcotics storage coordination included.'
  };

  let step1 = null, step2 = null, step3 = null;

  window.estBack = function(toStep) {
    document.getElementById('est-step-' + (toStep+1)).style.display = 'none';
    document.getElementById('est-step-' + toStep).style.display = 'block';
    if(toStep === 2) { step3 = null; document.querySelectorAll('#est-step-2 .est-option').forEach(b => b.classList.remove('selected')); }
    if(toStep === 1) { step2 = null; document.querySelectorAll('#est-step-1 .est-option').forEach(b => b.classList.remove('selected')); }
  };

  window.estReset = function() {
    step1 = step2 = step3 = null;
    document.getElementById('est-result').style.display = 'none';
    document.getElementById('est-step-1').style.display = 'block';
    document.querySelectorAll('.est-option').forEach(b => b.classList.remove('selected'));
  };

  function fmt(n) {
    if(n >= 1000000) return '$' + (n/1000000).toFixed(1) + 'M';
    return '$' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function showResult() {
    const [lo, hi] = rates[step1][step3];
    const low = Math.round(lo * step2 / 1000) * 1000;
    const high = Math.round(hi * step2 / 1000) * 1000;
    document.getElementById('est-result-type').textContent =
      step1.charAt(0).toUpperCase() + step1.slice(1).replace('-', ' ') +
      ' · ~' + step2.toLocaleString() + ' sq ft · ' +
      step3.charAt(0).toUpperCase() + step3.slice(1) + ' finish';
    document.getElementById('est-result-range').textContent = fmt(low) + ' – ' + fmt(high);
    document.getElementById('est-result-note').textContent = notes[step1] +
      ' This rough estimate is for budgeting purposes only. A formal quote requires a site visit.';
    document.getElementById('est-step-3').style.display = 'none';
    document.getElementById('est-result').style.display = 'block';
  }

  // Step 1 options
  document.querySelectorAll('#est-step-1 .est-option').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('#est-step-1 .est-option').forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');
      step1 = this.dataset.value;
      setTimeout(() => {
        document.getElementById('est-step-1').style.display = 'none';
        document.getElementById('est-step-2').style.display = 'block';
      }, 180);
    });
  });

  // Step 2 options
  document.querySelectorAll('#est-step-2 .est-option').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('#est-step-2 .est-option').forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');
      step2 = parseInt(this.dataset.value);
      setTimeout(() => {
        document.getElementById('est-step-2').style.display = 'none';
        document.getElementById('est-step-3').style.display = 'block';
      }, 180);
    });
  });

  // Step 3 options
  document.querySelectorAll('#est-step-3 .est-option').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('#est-step-3 .est-option').forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');
      step3 = this.dataset.value;
      setTimeout(showResult, 220);
    });
  });
})();
</script>
