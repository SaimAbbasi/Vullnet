            <div class="est-option-label">High-End</div>
            <div class="est-option-note">Premium. Custom millwork throughout, designer finishes, full acoustic treatment, feature elements.</div>
          </button>
        </div>
        <button class="est-back-btn" onclick="estBack(2)">Back</button>
