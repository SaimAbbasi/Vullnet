      <!-- RESULT -->
      <div id="est-result" style="display:none">
        <div style="background:#111;padding:40px 36px;border-top:3px solid var(--red)">
          <div style="font-size:.65rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--red);margin-bottom:16px">Rough Cost Estimate</div>
          <div id="est-result-type" style="font-size:.78rem;color:var(--gray2);margin-bottom:8px"></div>
          <div id="est-result-range" style="font-size:clamp(2rem,5vw,3.5rem);font-family:'Oswald',sans-serif;font-weight:700;color:var(--pure);line-height:1;margin-bottom:16px"></div>
          <div id="est-result-note" style="font-size:.87rem;line-height:1.7;color:var(--gray2);max-width:520px;margin-bottom:32px"></div>
          <div style="background:rgba(255,255,255,.04);padding:20px 24px;margin-bottom:32px;border-left:2px solid rgba(255,255,255,.1)">
            <p style="font-size:.82rem;color:var(--gray2);line-height:1.65;margin:0"><strong style="color:var(--pure)">Important:</strong> This is a planning-level estimate only, based on current GTA market rates. Actual cost depends on existing conditions, specific finishes, permit requirements, MEP complexity, and site-specific factors. A formal quote requires a site visit.</p>
          </div>
          <div style="display:flex;gap:16px;flex-wrap:wrap">
            <a href="/contact" class="btn btn-red">Get a Real Quote <svg class="arrow-icon" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M6 3h7v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <button class="btn btn-ghost" onclick="estReset()" style="cursor:pointer;font-family:inherit">Start Over</button>
          </div>
