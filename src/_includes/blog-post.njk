---
layout: base.njk
isBlogPost: true
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title | replace('"', '&quot;') }}",
  "description": "{{ description | replace('"', '&quot;') }}",
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ date | isoDate }}",
  "url": "https://www.vullnetnuragroup.com{{ page.url }}",
  "author": {
    "@type": "Organization",
    "name": "Vullnet Nura Group",
    "url": "https://www.vullnetnuragroup.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Vullnet Nura Group",
    "url": "https://www.vullnetnuragroup.com",
    "logo": {"@type": "ImageObject", "url": "https://www.vullnetnuragroup.com/public/og-image.png"}
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://www.vullnetnuragroup.com{{ page.url }}"
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".bp-meta", "h2", "p"]
  },
  "about": {
    "@type": "LocalBusiness",
    "name": "Vullnet Nura Group",
    "url": "https://www.vullnetnuragroup.com"
  }
}
</script>
<div class="bp-hero">
  <div class="bp-container">
    <nav class="bp-breadcrumb">
      <a href="/">Home</a> <span>/</span> <a href="/blog">Blog</a> <span>/</span> <span>{{ title }}</span>
    </nav>
    <div class="bp-meta r-left">
      <span class="bp-author">
        <span class="bp-author-avatar" aria-hidden="true">VN</span>
        Vullnet Nura
      </span>
      <span class="bp-dot">·</span>
      <span>{{ date | readableDate }}</span>
      <span class="bp-dot">·</span>
      <span>{{ readTime }} min read</span>
    </div>
    <h1 class="r-left">{{ title }}</h1>
    <p class="bp-desc r-left">{{ description }}</p>
  </div>
</div>

<article class="bp-body">
  <div class="bp-container">
    <nav class="bp-toc" id="bp-toc" aria-label="Table of contents"></nav>
    <div class="bp-content" id="bp-content">
      {{ content | safe }}
    </div>
    <div class="bp-further r">
      <div class="bp-further-label">Further Reading</div>
      {% for link in furtherReading %}
      <a href="{{ link.url }}" class="bp-further-link">{{ link.text }} <svg viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 13L13 3M6 3h7v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      {% endfor %}
    </div>
    <!-- Social share buttons -->
    <div class="bp-share">
      <span class="bp-share-label">Share this article</span>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.baseUrl }}{{ page.url }}" target="_blank" rel="noopener noreferrer" class="bp-share-btn bp-share-li" aria-label="Share on LinkedIn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </a>
      <a href="https://twitter.com/intent/tweet?url={{ site.baseUrl }}{{ page.url }}&text={{ title | urlencode }}" target="_blank" rel="noopener noreferrer" class="bp-share-btn bp-share-tw" aria-label="Share on X / Twitter">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X
      </a>
      <button class="bp-share-btn bp-share-copy" id="bp-copy-link" aria-label="Copy link">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
        Copy link
      </button>
    </div>
    <!-- Newsletter signup -->
    <div class="bp-newsletter r">
      <div class="bp-newsletter-inner">
        <div class="bp-newsletter-text">
          <div class="cx-eyebrow" style="margin-bottom:8px">Stay in the loop</div>
          <h3>Get new guides delivered<br>to your inbox.</h3>
          <p>Practical renovation knowledge for project managers and building owners. No filler.</p>
        </div>
        <form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact/thank-you/" class="bp-newsletter-form">
          <input type="hidden" name="form-name" value="newsletter">
          <input type="hidden" name="bot-field" style="display:none">
          <div class="bp-nl-row">
            <input type="email" name="email" placeholder="your@email.com" required class="bp-nl-input" aria-label="Email address">
            <button type="submit" class="bp-nl-btn">Subscribe</button>
          </div>
        </form>
      </div>
    </div>

    <div class="bp-cta r-scale">
      <div class="cta-line"></div>
      <h2>Ready to start your project?</h2>
      <p>Tell us what you're building. We'll come back with a clear scope, honest timeline, and a number you can trust.</p>
      <a href="/contact" class="btn btn-red">Get a Quote <svg class="arrow-icon" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M6 3h7v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
  </div>
</article>

<!-- Related posts -->
{% set related = collections.blog | exclude(page.url) | limit(3) %}
{% if related.length %}
<section class="bp-related">
  <div class="bp-container">
    <div class="cx-eyebrow" style="margin-bottom:24px">Keep Reading</div>
    <div class="bp-related-grid">
      {% for post in related %}
      <article class="bp-related-card r">
        <div class="bp-related-meta">{{ post.date | readableDate }} &middot; {{ post.data.readTime }} min</div>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.description }}</p>
        <a href="{{ post.url }}" class="bl-read-more">Read Article <svg viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 13L13 3M6 3h7v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
