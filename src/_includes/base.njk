  <a href="/contact" class="cx-mobile-cta-quote">Get a Quote</a>
</div>

<!-- Back to top button -->
<button class="cx-back-top" id="cx-back-top" aria-label="Back to top">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
</button>

<script src="/public/js/main.js"></script>
</body>
</html>
