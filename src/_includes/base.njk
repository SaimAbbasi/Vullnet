<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or site.name }}</title>
<meta name="description" content="{{ description or site.defaultDescription }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ site.baseUrl }}{{ permalink or page.url }}">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.defaultDescription }}">
<meta property="og:url" content="{{ site.baseUrl }}{{ permalink or page.url }}">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title or site.name }}">
<meta name="twitter:description" content="{{ description or site.defaultDescription }}">

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "GeneralContractor"],
  "name": "Vullnet Nura Group",
  "alternateName": "VNG",
  "description": "Commercial interior renovation contractor serving the Greater Toronto Area. Specializing in office tenant improvements, medical office renovations, restaurant fit-outs, retail buildouts, and industrial renovations. 1000+ projects delivered on time across Ontario.",
  "url": "{{ site.baseUrl }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Mississauga",
    "addressRegion": "ON",
    "addressCountry": "CA"
  },
  "areaServed": [
    {"@type": "City", "name": "Toronto"},
    {"@type": "City", "name": "Mississauga"},
    {"@type": "City", "name": "Brampton"},
    {"@type": "City", "name": "Vaughan"},
    {"@type": "City", "name": "Markham"},
    {"@type": "City", "name": "Oakville"},
    {"@type": "City", "name": "Burlington"},
    {"@type": "City", "name": "Hamilton"},
    {"@type": "City", "name": "Richmond Hill"},
    {"@type": "City", "name": "Etobicoke"},
    {"@type": "City", "name": "Scarborough"},
    {"@type": "City", "name": "North York"}
  ],
  "serviceType": [
    "Commercial Renovation",
    "Office Tenant Improvement",
    "Medical Office Renovation",
    "Restaurant Renovation",
    "Retail Fit-Out",
    "Industrial Renovation",
    "Demolition",
    "Drywall and Framing",
    "Commercial Millwork",
    "Trade Coordination"
  ],
  "knowsAbout": [
    "Commercial Interior Renovation",
    "Tenant Improvement Construction",
    "ICRA Infection Control",
    "AODA Accessibility Compliance",
    "Ontario Building Code",
    "MEP Trade Coordination",
    "Commercial Permit Management"
  ],
  "sameAs": [],
  "priceRange": "$$"
}
</script>
{{ jsonLd | safe if jsonLd }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/css/style.css">
</head>
<body>

<div id="cx-progress" aria-hidden="true"></div>
<div class="cx-cursor" aria-hidden="true"><div class="cx-cursor-ring"></div></div>

{% include "nav.njk" %}

{{ content | safe }}

{% include "footer.njk" %}

<script src="/public/js/main.js"></script>
</body>
</html>
