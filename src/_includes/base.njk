<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or site.name }}</title>
<meta name="description" content="{{ description or site.defaultDescription }}">
<meta name="robots" content="{{ robots or 'index, follow' }}">
<meta name="theme-color" content="#1a1a1a">
<link rel="canonical" href="{{ site.baseUrl }}{{ permalink or page.url }}">

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
<link rel="shortcut icon" href="/public/favicon.svg">
<link rel="apple-touch-icon" href="/public/apple-touch-icon.png">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.defaultDescription }}">
<meta property="og:url" content="{{ site.baseUrl }}{{ permalink or page.url }}">
<meta property="og:image" content="{{ site.baseUrl }}/public/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:type" content="image/png">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.baseUrl }}/public/og-image.png">

<meta name="twitter:title" content="{{ title or site.name }}">
<meta name="twitter:description" content="{{ description or site.defaultDescription }}">

<!-- JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "GeneralContractor"],
  "name": "Vullnet Nura Group",
  "alternateName": "VNG",
  "description": "Commercial interior renovation contractor serving the Greater Toronto Area. Specializing in office tenant improvements, medical office renovations, restaurant fit-outs, retail buildouts, and industrial renovations. 1000+ projects delivered on time across Ontario.",
  "url": "{{ site.baseUrl }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Mississauga",
    "addressRegion": "ON",
    "addressCountry": "CA"
  },
  "areaServed": [
    {"@type": "City", "name": "Toronto"},
    {"@type": "City", "name": "Mississauga"},
    {"@type": "City", "name": "Brampton"},
    {"@type": "City", "name": "Vaughan"},
    {"@type": "City", "name": "Markham"},
    {"@type": "City", "name": "Oakville"},
    {"@type": "City", "name": "Burlington"},
    {"@type": "City", "name": "Hamilton"},
    {"@type": "City", "name": "Richmond Hill"},
    {"@type": "City", "name": "Etobicoke"},
    {"@type": "City", "name": "Scarborough"},
    {"@type": "City", "name": "North York"}
  ],
  "serviceType": [
    "Commercial Renovation",
    "Office Tenant Improvement",
    "Medical Office Renovation",
    "Restaurant Renovation",
    "Retail Fit-Out",
    "Industrial Renovation",
    "Demolition",
    "Drywall and Framing",
    "Commercial Millwork",
    "Trade Coordination"
  ],
  "knowsAbout": [
    "Commercial Interior Renovation",
    "Tenant Improvement Construction",
    "ICRA Infection Control",
    "AODA Accessibility Compliance",
    "Ontario Building Code",
    "MEP Trade Coordination",
    "Commercial Permit Management"
  ],
  "sameAs": [
    "https://www.linkedin.com/company/vullnet-nura-group",
    "https://www.instagram.com/vullnetnuragroup/",
    "https://www.facebook.com/profile.php?id=61589509721131"
  ],
  "telephone": "+12893396697",
  "priceRange": "$$",
  "openingHours": "Mo-Fr 08:00-18:00",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "08:00",
    "closes": "18:00"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": "47",
    "bestRating": "5",
    "worstRating": "1"
  }
}
</script>
{{ jsonLd | safe if jsonLd }}
{% if page.url != '/' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":"https://www.vullnetnuragroup.com/"}{% if isBlogPost %},
    {"@type":"ListItem","position":2,"name":"Blog","item":"https://www.vullnetnuragroup.com/blog/"},
    {"@type":"ListItem","position":3,"name":"{{ title | replace('"','&quot;') }}","item":"https://www.vullnetnuragroup.com{{ page.url }}"}{% else %},
    {"@type":"ListItem","position":2,"name":"{{ title | replace('"','&quot;') }}","item":"https://www.vullnetnuragroup.com{{ page.url }}"}{% endif %}
  ]
}
</script>
{% endif %}

<!-- HubSpot tracking, replace XXXXXXX with your HubSpot portal ID -->
<!-- <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/XXXXXXX.js"></script> -->

<!-- Google Analytics 4, replace G-XXXXXXXXXX with actual measurement ID -->
<!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-XXXXXXXXXX');</script> -->

<link rel="alternate" type="application/rss+xml" title="VNG Blog" href="/blog/feed.xml">
<link rel="stylesheet" href="/public/css/fonts.css">
<link rel="stylesheet" href="/public/css/style.css">
</head>
<body>

<a href="#main-content" class="cx-skip-link">Skip to content</a>
<div id="cx-progress" aria-hidden="true"></div>
<div class="cx-cursor" aria-hidden="true"><div class="cx-cursor-ring"></div></div>

{% include "nav.njk" %}

<main id="main-content">
{{ content | safe }}
</main>

{% include "footer.njk" %}

