    <div class="cx-calc r" style="margin-top:48px;background:var(--dark);padding:40px;border:1px solid rgba(255,255,255,.08)">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:32px">
        <div class="cx-form-group">
          <label for="calc-type">Project Type</label>
          <select id="calc-type" onchange="calcEstimate()">
            <option value="">Select type</option>
            <option value="60,120">Office TI, Basic</option>
            <option value="120,180">Office TI, Corporate</option>
            <option value="150,250">Medical / Dental</option>
            <option value="180,350">Restaurant / Hospitality</option>
            <option value="100,160">Retail Fit-Out</option>
            <option value="80,140">Industrial Office</option>
          </select>
        </div>
        <div class="cx-form-group">
          <label for="calc-sqft">Square Footage</label>
          <input type="number" id="calc-sqft" placeholder="e.g. 3500" oninput="calcEstimate()" min="100" max="100000">
        </div>
      </div>
      <div id="calc-result" style="display:none;padding:24px;border:1px solid rgba(216,48,48,.3);background:rgba(216,48,48,.05)">
        <div style="font-size:.7rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--red);margin-bottom:8px">Rough Budget Range</div>
        <div id="calc-range" style="font-family:'Oswald',sans-serif;font-size:2rem;font-weight:600;color:var(--pure)"></div>
        <div id="calc-rate" style="font-size:.8rem;color:var(--gray2);margin-top:6px"></div>
        <p style="font-size:.82rem;color:var(--gray2);margin-top:16px;line-height:1.6">This is a planning reference only, not a quote. Your actual number depends on existing conditions, finish specifications, MEP scope, and permit requirements. <a href="/contact" style="color:var(--red)">Get a real itemized quote →</a></p>
      </div>
      <div id="calc-placeholder" style="padding:24px;border:1px solid rgba(255,255,255,.08);text-align:center;color:var(--gray2);font-size:.88rem">
        Select a project type and enter square footage above.
