<section class="cx-section cx-spotlight" id="cost-estimate" style="background:var(--dark2)">
  <div class="cx-container" style="max-width:720px">
    <div class="r" style="text-align:center">
      <div class="cx-eyebrow">Rough Estimate Tool</div>
      <h2 class="cx-h2">Get a ballpark before<br>you call us.</h2>
