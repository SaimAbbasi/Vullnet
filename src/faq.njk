<script>
function calcEstimate() {
  const type = document.getElementById('calc-type').value;
  const sqft = parseFloat(document.getElementById('calc-sqft').value);
  const result = document.getElementById('calc-result');
  const placeholder = document.getElementById('calc-placeholder');
  if (!type || !sqft || sqft < 100) { result.style.display='none'; placeholder.style.display='block'; return; }
  const [low, high] = type.split(',').map(Number);
  const lowTotal = Math.round(low * sqft / 1000) * 1000;
  const highTotal = Math.round(high * sqft / 1000) * 1000;
  const fmt = n => '$' + n.toLocaleString('en-CA');
  document.getElementById('calc-range').textContent = fmt(lowTotal) + ' - ' + fmt(highTotal);
  document.getElementById('calc-rate').textContent = '$' + low + '-$' + high + ' per sq ft · ' + sqft.toLocaleString('en-CA') + ' sq ft';
  result.style.display='block';
  placeholder.style.display='none';
}
</script>
